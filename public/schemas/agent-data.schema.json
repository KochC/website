{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koch.codes/schemas/agent-data.schema.json",
  "title": "koch.codes agent data",
  "description": "Structured facts about Christopher Koch, generated from the public pages of koch.codes.",
  "type": "object",
  "required": [
    "site",
    "profile",
    "experience",
    "publications",
    "apps",
    "contact"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "generated_from": {
      "type": "string",
      "format": "uri"
    },
    "site": {
      "type": "object",
      "required": [
        "name",
        "url",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "name",
        "title",
        "summary",
        "skills",
        "languages"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "level": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "contact": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "company",
          "roles"
        ],
        "properties": {
          "company": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "period",
                "description"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "authors",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^arXiv:"
          },
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "abstract": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "year": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "issuer": {
            "type": [
              "string",
              "null"
            ]
          },
          "year": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "summary",
          "privacy",
          "support",
          "url"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tagline": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "appStore": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "privacy": {
            "type": "string",
            "format": "uri"
          },
          "support": {
            "type": "string",
            "format": "uri"
          },
          "markdown": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "url",
          "markdown"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "markdown": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "support": {
          "type": "string",
          "format": "email"
        },
        "linkedin": {
          "type": "string",
          "format": "uri"
        },
        "github": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
